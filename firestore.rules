rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Tiers can be read by anyone
    // Update allowed for Admins OR vendors decrementing stock by 1
    match /booth_tiers/{tierId} {
      allow read: if true;
      allow update: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches("(?i)admin@nlf\\.com") ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock == resource.data.stock - 1 &&
          resource.data.stock > 0 &&
          resource.data.isLocked == false
        )
      );
      allow create, delete: if request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.email.matches("(?i)admin@nlf\\.com"));
    }
    
    // Orders can be created by authenticated users
    match /booth_orders/{orderId} {
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid ||
         request.auth.token.admin == true ||
         request.auth.token.email.matches("(?i)admin@nlf\\.com"));
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.token.admin == true || request.auth.token.email.matches("(?i)admin@nlf\\.com"));
    }

    // Metadata stats for sequence numbering
    match /metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
